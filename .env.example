# MediKiosk Environment Variables Configuration

# Server Ports
PORT=8080
FRONTEND_PORT=5173

# Database (Optional PostgreSQL Profile)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medikiosk
DB_USER=postgres
DB_PASSWORD=postgrespassword

# AI Provider Configuration (Default: mock)
# Options: mock, gemini, openai
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ABDM & HIS Sandbox Settings
ABDM_FACILITY_ID=IN-MH-AIIA-0021
ABDM_FACILITY_NAME=All India Institute of Ayurveda, New Delhi
ABDM_INTEGRATION_MODE=mock
